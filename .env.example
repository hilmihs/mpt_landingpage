# ============================================================
# Muhajir Project Tilawah — Environment Variables Template
# ============================================================
# Dev  : salin ke .env.local
# Prod : Secret Manager, dipasang ke Cloud Run (lihat docs/DEPLOY_GCP.md)
# JANGAN commit .env.local.
#
# Tanda [WAJIB] = aplikasi tidak jalan tanpa ini.
# ============================================================

# ---------- Postgres [WAJIB] ----------
# Dev: `docker compose up -d` lalu pakai baris di bawah apa adanya.
# Prod: Cloud SQL. Lewat Cloud SQL connector pakai socket:
#   postgres://USER:PASS@/mpt?host=/cloudsql/PROJECT:asia-southeast2:INSTANCE
DATABASE_URL=postgres://mpt:mpt_local_dev@localhost:5433/mpt
# Koneksi maksimum per instance (default 5). Naikkan hati-hati — Cloud Run
# menjalankan banyak instance sekaligus dan Cloud SQL punya batas total.
# DATABASE_POOL_MAX=5
# "true" kalau konek lewat IP publik. Private IP / socket tidak perlu.
# DATABASE_SSL=false

# ---------- Auth.js [WAJIB] ----------
# Penandatangan sesi. Generate: openssl rand -hex 32
# Mengganti nilai ini akan mengeluarkan semua orang dari sesinya.
AUTH_SECRET=

# ---------- Storage audio ----------
# Kosongkan untuk dev — audio disimpan di ./.data/audio.
# Prod [WAJIB]: nama bucket Cloud Storage, region asia-southeast2.
# Pasang lifecycle rule 7 hari di bucket ini (retensi UU PDP).
GCS_BUCKET=
# Penandatangan URL audio driver lokal. Generate: openssl rand -hex 32
# Kalau kosong, dipakai WORKER_SECRET.
STORAGE_SIGNING_SECRET=

# ---------- WhatsApp via kirimi.id [WAJIB untuk notifikasi] ----------
# Ambil dari dashboard kirimi.id. Perangkat harus sudah dipasangkan (scan QR)
# sebelum bisa mengirim. Kalau ketiganya kosong, pesan hanya dicatat ke log dan
# alur tetap jalan — tapi pengajar tidak akan menerima notifikasi apa pun.
KIRIMI_USER_CODE=
KIRIMI_DEVICE_ID=
KIRIMI_SECRET=

# Penampung terakhir kalau belum ada pengajar aktif yang cocok gendernya.
# Format bebas (+62/62/08), dinormalkan otomatis.
SUPERADMIN_WA=
SUPERADMIN_NAMA=

# ---------- Penilaian pengajar (muhajirproject) ----------
# API publik read-only. Default sudah benar, isi hanya kalau alamatnya berubah.
# MPT_ASSESSMENT_API_BASE=https://assesment-alfatihah.muhajirproject.com/api
# Formulir yang dibuka pengajar di tab baru.
# MPT_EVAL_FORM_URL=https://assesment-alfatihah.muhajirproject.com/recitation-evaluations/create

# ---------- Upstash Redis (antrian ML) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Server inferensi ML ----------
# Kalau diisi, /api/worker memanggil Mu'alim asli; kalau kosong pakai mock.
ML_SERVER_URL=
ML_SERVER_API_KEY=

# ---------- DeepSeek (narasi AI di rapot) ----------
# OpenAI-compatible. Cek id model di https://api-docs.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- Google Meet (via Google Workspace) ----------
# Service account JSON key dengan domain-wide delegation.
# Tempel SELURUH isi JSON (diminifikasi).
# Scope yang harus disetujui di Admin Console → Security → API Controls:
#   - https://www.googleapis.com/auth/calendar.events
#   - https://www.googleapis.com/auth/meetings.space.readonly
GOOGLE_SERVICE_ACCOUNT_KEY=

# ---------- Secret internal [WAJIB] ----------
# Melindungi /api/worker dan /api/cleanup. Generate: openssl rand -hex 32
WORKER_SECRET=
CLEANUP_SECRET=

# ---------- URL situs [WAJIB] ----------
# Dipakai untuk tautan absolut di pesan WhatsApp. Salah isi = pengajar dan
# peserta menerima tautan yang tidak bisa dibuka.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Opsional: dev ----------
# "1" untuk melewati rate limit IP di /api/submit
DEV_BYPASS_RATELIMIT=
