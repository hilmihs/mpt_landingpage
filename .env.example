# ============================================================
# Muhajir Project Tilawah — Environment Variables Template
# ============================================================
# Copy this to .env.local for dev, and set the same vars in
# Vercel project settings for production.
# Do NOT commit .env.local to git.
# ============================================================

# ---------- Supabase ----------
# Project URL: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon (public) key — safe to expose to browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Upstash Redis (BullMQ queue) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- ML Inference Server (Phase 4) ----------
# When set, /api/worker calls real Mu'alim instead of mock-ml
ML_SERVER_URL=
ML_SERVER_API_KEY=

# ---------- Teacher Assessment (pulled from muhajirproject.com) ----------
# Holistic teacher assessment results (scale 1-10), separate from the AI rapot.
# Auth + response contract not yet available — obtain from the muhajirproject.com
# dashboard, then implement mapExternalToTeacherResult() in lib/teacher-assessment.ts.
# When unset, fetchTeacherAssessment() returns null (UI shows "belum tersedia").
TEACHER_ASSESSMENT_BASE_URL=
TEACHER_ASSESSMENT_API_KEY=

# ---------- DeepSeek (AI narrative on rapot) ----------
# OpenAI-compatible. Verify model id at https://api-docs.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- Google Meet (via Google Workspace) ----------
# Service account JSON key with domain-wide delegation enabled.
# Paste the ENTIRE JSON key content (minified) here.
# Required scopes (approved in Workspace Admin Console → Security → API Controls):
#   - https://www.googleapis.com/auth/calendar.events
#   - https://www.googleapis.com/auth/meetings.space.readonly
GOOGLE_SERVICE_ACCOUNT_KEY=

# ---------- Site URL (for absolute redirects) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Optional: rate limiting bypass for dev ----------
# Set to "1" to bypass IP rate limiting on /api/submit
DEV_BYPASS_RATELIMIT=
